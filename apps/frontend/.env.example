# Copy this file to .env (this directory) before running the frontend locally.
# .env is gitignored — never commit real values here.
#
# These come from your Firebase project's web app config:
# Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration.
# Also make sure the "Email/Password" sign-in provider is enabled under
# Authentication -> Sign-in method, and that the users you want to log in
# with exist under Authentication -> Users (or that they can self-register,
# if that flow is added later).

VITE_FIREBASE_API_KEY= 
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
