      { "glob": "backend/src/venues/venues.service.spec.ts", "titleMatch": "VEN-UPD-" }
    ],
    "backend-e2e": [
      { "glob": "backend/test/venues.e2e-spec.ts", "titleMatch": "VEN-UPD-" }
    ]
  },
  "sources": {
    "frontend": [
      "frontend/src/features/venues/pages/edit/VenueEditPage.tsx",
