{
  "story": "SPM-121",
  "title": "Update Venue Records",
  "note": "SPM-121 AC1-AC9 defines the PATCH /venues/:id endpoint for Venue Staff to update their own venue records. Test IDs VEN-UPD-* cover repository, service, UI and E2E evidence. Confluence matrix page 28770883 (38 test cases) is the authoritative test matrix; all test cases created 2026-10-30. Coverage includes VenueEditPage.tsx, useAppStore.ts (updateVenue), venues.repository.ts (update), venues.service.ts (update). Unrelated SPM-50 create and SPM-124 read paths remain covered by their own stories.",
  "tz": ["UTC", "Asia/Singapore"],
  "linesFrom": "changed-lines",
  "coverageFloor": { "statements": 80, "branches": 80, "functions": 80, "lines": 80 },
  "tests": {
    "frontend": [
      { "glob": "frontend/src/features/venues/pages/edit/VenueEditPage.test.tsx", "titleMatch": "VEN-UPD-" },
      { "glob": "frontend/src/store/useAppStore.venues.test.ts", "titleMatch": "VEN-UPD-" }
    ],
