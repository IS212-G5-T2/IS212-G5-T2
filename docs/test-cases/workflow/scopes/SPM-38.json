{
  "story": "SPM-38",
  "title": "Review Submitted Event Request Details",
  "note": "Scope for SPM-38 (Review Submitted Event Request Details), built for the SPM-150 Sprint 1 workflow records. Matrix: ai/runtime/test-cycles/SPM-38/cycle-02/confluence-matrix-ids.txt (saved from Confluence matrix pages). Shared files are narrowed with titleMatch on the story prefix; a test without its own ID in its title is not counted (see the G1 output). Parent ACs are matrix rows, not Jira ACs, until the Requirement reviewer confirms them.",
  "tz": [
    "UTC",
    "Asia/Singapore",
    "America/Los_Angeles"
  ],
  "coverageFloor": {
    "statements": 100,
    "branches": 100,
    "functions": 100,
    "lines": 100
  },
  "tests": {
    "backend-unit": [
      {
        "glob": "backend/src/events/events.service.spec.ts",
        "titleMatch": "EVE-REV"
      }
    ],
    "frontend": [
      {
        "glob": "frontend/src/features/events/pages/detail/EventDetailPage.test.tsx",
        "titleMatch": "EVE-REV"
      },
      {
        "glob": "frontend/src/features/events/pages/detail/EventDetailPage.decision.test.tsx",
        "titleMatch": "EVE-REV"
      }
    ],
    "backend-e2e": [
      "backend/test/events-assign.e2e-spec.ts"
    ]
  },
  "sources": {
    "backend": [
      "backend/src/events/events.service.ts"
    ],
    "frontend": [
      "frontend/src/features/events/pages/detail/EventDetailPage.tsx"
    ]
  },
  "suites": [
    {
      "id": "backend-unit",
      "cwd": "backend",
      "tests": "backend-unit",
      "config": null,
      "coverage": "backend",
      "env": []
    },
    {
      "id": "backend-e2e",
      "cwd": "backend",
      "tests": "backend-e2e",
      "config": "./vitest.config.e2e.ts",
      "coverage": "backend",
      "env": [
        "DATABASE_URL"
      ]
    },
    {
      "id": "frontend",
      "cwd": "frontend",
      "tests": "frontend",
      "config": null,
      "coverage": "frontend",
      "env": []
    }
  ],
  "mutation": [
    {
      "id": "backend-spm38",
      "cwd": "backend",
      "command": [
        "node",
        "scripts/mutation/run.mjs",
        "--mutants",
        "spm38.mutants.mjs"
      ],
      "mutantsFile": "backend/scripts/mutation/spm38.mutants.mjs",
      "export": "MUTANTS",
      "env": []
    },
    {
      "id": "frontend-spm38",
      "cwd": "frontend",
      "command": [
        "node",
        "scripts/testing/mutation/run.mjs",
        "--mutants",
        "spm38.mutants.mjs"
      ],
      "mutantsFile": "frontend/scripts/testing/mutation/spm38.mutants.mjs",
      "export": "MUTANTS",
      "env": []
    }
  ]
}
