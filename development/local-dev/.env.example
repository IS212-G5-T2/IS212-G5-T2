# Copy this file to .env before starting the local stack.

PROJECT_ID=local-spm
REGION=asia-southeast1
ENVIRONMENT=local

# Mirrors Terraform defaults.
CLOUD_SQL_CONNECTION_NAME=local-spm:asia-southeast1:spm-db
CLOUD_SQL_DATABASE=spm
STORAGE_BUCKET=local-spm-spm-objects-local
PUBSUB_TOPIC=spm-events
PUBSUB_SUBSCRIPTION=spm-events-microservices

# Local PostgreSQL substitute for Cloud SQL.
POSTGRES_USER=spm
POSTGRES_PASSWORD=spm_dev_password
POSTGRES_DB=spm
DATABASE_URL=postgres://spm:spm_dev_password@postgres:5432/spm
DB_HOST=postgres
DB_PORT=5432

# Local emulator endpoints used by application code and Google SDKs.
PUBSUB_EMULATOR_HOST=pubsub-emulator:8085
STORAGE_EMULATOR_HOST=http://gcs:4443

# Sample service port inside the container. The local gateway exposes it on localhost:8080.
PORT=8080
