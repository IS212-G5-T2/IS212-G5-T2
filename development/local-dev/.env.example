# Copy this file to .env before starting the local stack.

# Real Firebase Web app configuration. Copy this file to `.env` and fill these
# with values from Firebase Console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_AUTH_EMULATOR=false
ENVIRONMENT=local

# Local PostgreSQL settings.
POSTGRES_USER=spm
POSTGRES_PASSWORD=spm_dev_password
POSTGRES_DB=spm
DATABASE_URL=postgres://spm:spm_dev_password@postgres:5432/spm
DB_HOST=postgres
DB_PORT=5432

# Backend service port, exposed directly on localhost:3000.
FRONTEND_ORIGIN=http://localhost:5173

# Required for real Firebase Admin token verification from the backend
# container. Put the complete service-account JSON on one line in the local
# `.env` file; it is never committed.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Frontend settings used by the Vite development container.
VITE_API_BASE_URL=http://localhost:3000
# Local demo identity; never enable in production.
DEMO_ORGANISER_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5173
