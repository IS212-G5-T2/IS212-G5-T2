# Copy this file to .env before starting the local stack.

# These defaults are used only by the local Auth Emulator. Do not replace them
# with real Firebase credentials unless emulator mode is deliberately disabled.
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-is212.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-is212
VITE_FIREBASE_STORAGE_BUCKET=demo-is212.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:local
ENVIRONMENT=local

# Local PostgreSQL settings.
POSTGRES_USER=spm
POSTGRES_PASSWORD=spm_dev_password
POSTGRES_DB=spm
DATABASE_URL=postgres://spm:spm_dev_password@postgres:5432/spm
DB_HOST=postgres
DB_PORT=5432

# Backend service port, exposed directly on localhost:3000.
FRONTEND_ORIGIN=http://localhost:5173

# Frontend settings used by the Vite development container.
VITE_API_BASE_URL=http://localhost:3000
