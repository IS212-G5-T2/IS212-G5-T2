# Copy this file to .env before starting the local stack.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
ENVIRONMENT=local

# Local PostgreSQL settings.
POSTGRES_USER=spm
POSTGRES_PASSWORD=spm_dev_password
POSTGRES_DB=spm
DATABASE_URL=postgres://spm:spm_dev_password@postgres:5432/spm
DB_HOST=postgres
DB_PORT=5432

# Backend service port, exposed directly on localhost:3000.
FRONTEND_ORIGIN=http://localhost:5173

# Frontend settings used by the Vite development container.
VITE_API_BASE_URL=http://localhost:3000
