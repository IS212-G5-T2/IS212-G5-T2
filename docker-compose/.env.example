# Copy this file to .env before starting the local stack.

ENVIRONMENT=local

# Local PostgreSQL settings.
POSTGRES_USER=spm
POSTGRES_PASSWORD=spm_dev_password
POSTGRES_DB=spm
DATABASE_URL=postgres://spm:spm_dev_password@postgres:5432/spm
DB_HOST=postgres
DB_PORT=5432

# Backend service port, exposed directly on localhost:8080.
FRONTEND_ORIGIN=http://localhost:5173

# Authentication sessions. Keep false for the local HTTP Compose stack; set
# true only behind HTTPS.
AUTH_COOKIE_NAME=connectsphere_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=8

# Frontend settings used by the Vite development container.
VITE_API_BASE_URL=http://localhost:8080
# Local demo identity; never enable in production.
DEMO_ORGANISER_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5173
