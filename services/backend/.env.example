PORT=8080

# PostgreSQL connection string used by DatabaseService for RBAC lookups.
DATABASE_URL=postgresql://spm:spm@localhost:5432/spm

# Optional Firebase Admin service account file path for local development.
# Leave empty to use application default credentials.
# Do not commit the real JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional fallback for CI/emergency usage when a file is awkward.
# Prefer FIREBASE_SERVICE_ACCOUNT_PATH locally.
# Do not commit real service account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
