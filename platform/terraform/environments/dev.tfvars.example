project_id  = "your-gcp-project-id"
region      = "asia-southeast1"
gke_location = "asia-southeast1-a"
environment = "dev"

network_name  = "spm-network"
subnet_cidr   = "10.10.0.0/20"
pods_cidr     = "10.20.0.0/16"
services_cidr = "10.30.0.0/20"

vpc_flow_logs_sampling = 0
nat_log_filter         = "ERRORS_ONLY"

enable_api_gateway = false
# backend_url = "https://replace-with-gke-gateway-api-endpoint.example.com"

gke_gateway_api_channel      = "CHANNEL_STANDARD"
gke_enable_private_endpoint = false
node_count                   = 1
node_machine_type            = "e2-small"

identity_platform_google_provider_enabled = false
# identity_platform_google_oauth_client_id     = "replace-with-google-oauth-client-id"
# identity_platform_google_oauth_client_secret = "supply-from-protected-variable-source"

# storage_bucket_name = "your-gcp-project-id-spm-objects-dev"
cloud_sql_ssl_mode            = "ENCRYPTED_ONLY"
cloud_sql_deletion_protection = false

log_bucket_id             = "spm-central-logs"
log_bucket_retention_days = 7
enable_log_bucket_cmek    = false

# monitoring_alert_email_addresses = [
#   "alerts@example.com"
# ]

enable_budget_alerts = false
# billing_account_id    = "000000-000000-000000"
# monthly_budget_amount = 100
# budget_currency_code  = "SGD"

secrets = [
  "database-url",
  "service-config"
]

# Optional: split workload identities and least-privilege resource access per microservice.
# Leave unset to use one baseline "microservices" identity.
# microservice_identities = {
#   events = {
#     kubernetes_namespace           = "spm"
#     kubernetes_service_account_name = "events-service"
#     secrets                         = ["database-url"]
#     cloud_sql_client                = true
#     storage_object_admin            = false
#     pubsub_publish_topics           = ["spm-events"]
#     pubsub_subscribe_subscriptions  = []
#   }
# }

pubsub_topics = [
  "spm-events"
]

pubsub_subscriptions = {
  spm-events-microservices = {
    topic = "spm-events"
  }
}
